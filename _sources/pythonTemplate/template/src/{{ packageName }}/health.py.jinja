"""Infrastructure liveness and readiness routes."""

from __future__ import annotations

{% if withPersistence | default(false) %}import asyncio
import logging

from fastapi import APIRouter, HTTPException, Request
from sqlalchemy import text
from sqlalchemy.exc import SQLAlchemyError
from sqlalchemy.ext.asyncio import AsyncEngine
{% else %}from fastapi import APIRouter
{% endif %}
router = APIRouter(include_in_schema=False)


@router.get("/health/live")
async def live() -> dict[str, str]:
    """Confirm the HTTP process is serving requests."""
    return {"status": "alive"}


@router.get("/health/ready")
async def ready({% if withPersistence | default(false) %}request: Request{% endif %}) -> dict[str, str]:
    """Check only dependencies enabled for this service."""
{% if withPersistence | default(false) %}    engine = getattr(request.app.state, "db_engine", None)
    if not isinstance(engine, AsyncEngine):
        raise RuntimeError("Database resource is not initialized")
    try:
        async with asyncio.timeout(2.0):
            async with engine.connect() as connection:
                await connection.execute(text("SELECT 1"))
    except (OSError, TimeoutError, SQLAlchemyError) as exc:
        logging.getLogger("{{ projectName }}").warning("Required database unavailable")
        raise HTTPException(
            status_code=503, detail="Required dependency unavailable"
        ) from exc
{% endif %}    return {"status": "ready"}
