# syntax=docker/dockerfile:1
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS build
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
{% if withPersistence | default(false) %}COPY alembic.ini ./
COPY migrations ./migrations
{% endif %}
RUN python -m pip install --no-cache-dir uv==0.12.15 && uv sync --locked --no-dev

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
USER 65532:65532
CMD ["uvicorn", "{{ packageName }}.app:app", "--host", "0.0.0.0", "--port", "8000"]
