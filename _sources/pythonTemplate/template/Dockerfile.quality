# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM ghcr.io/astral-sh/uv:0.12.15@sha256:62f8c047d0a0e9ece6b53fc63df902585a67a47a7f318ddec4a37db586edc8e3 AS uv
FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56 AS quality-dependencies
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends make git build-essential cmake ninja-build ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PATH=/app/.venv/bin:$PATH UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 CONTAINERIZED=1
COPY pyproject.toml uv.lock README.md .gitignore ./
ARG TARGETPLATFORM
RUN --mount=type=cache,id=python-quality-dependencies-uv-314-${TARGETPLATFORM},target=/root/.cache/uv,sharing=locked uv sync --locked --all-groups --no-install-project
FROM quality-dependencies AS quality
COPY --chmod=u=rwX,go=rX . ./
RUN --mount=type=cache,id=python-quality-development-uv-314-${TARGETPLATFORM},target=/root/.cache/uv,sharing=locked uv sync --locked --all-groups
CMD ["make", "check"]

FROM quality AS package-build
RUN --mount=type=cache,id=python-quality-package-uv-314-${TARGETPLATFORM},target=/root/.cache/uv,sharing=locked uv build --wheel --sdist --out-dir /artifacts
FROM scratch AS artifacts
COPY --from=package-build /artifacts/ /

FROM quality-dependencies AS installed-test
COPY --from=package-build /artifacts/*.whl /wheels/
RUN uv pip install --python /app/.venv/bin/python --no-deps /wheels/*.whl
WORKDIR /checks
COPY --exclude=src --exclude=src/** --chmod=u=rwX,go=rX . ./
ENV COVERAGE_FILE=/app/coverage/installed/.coverage
CMD ["python", "-m", "pytest", "--cov", "--cov-report=term-missing", "--cov-report=json:/app/coverage/installed/coverage.json", "--cov-report=xml:/app/coverage/installed/coverage.xml", "-p", "no:cacheprovider", "--basetemp=/tmp/tests"]
