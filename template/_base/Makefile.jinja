ifneq ($(CONTAINERIZED),1)
{% block dockerSettings %}QUALITY_IMAGE := {{ packageName }}:quality
# Generated check owns its complete graph; opt into extras only when defined.
QUALITY_EXTRA_TARGETS :=
BUILD_DOCKERFILE := Dockerfile.quality{% endblock %}
include docker/quality-python.mk
else
.DEFAULT_GOAL := help
UV ?= uv

.PHONY: help install format lint typecheck test test-unit check build{% block extraPhony %}{% endblock %}

help: ## Show the supported development commands.
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z0-9_-]+:.*## / {printf "  %-18s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

install: ## Install the locked development environment.
	$(UV) sync --locked

format: ## Format owned Python sources.
	$(UV) run --locked ruff check --fix .
	$(UV) run --locked ruff format .

lint: ## Check formatting and lint without modifying files.
	$(UV) run --locked ruff check .
	$(UV) run --locked ruff format --check .

typecheck: ## Check strict Python types.
	$(UV) run --locked mypy

{% if withTesting | default(true) %}test-unit: ## Run isolated tests and complete Python coverage.
	$(UV) run --locked pytest --cov --cov-report=term-missing --cov-report=json --cov-report=xml
{% else %}test-unit: ## Fail explicitly because this render omitted testing support.
	@echo 'Testing was disabled for this render.' >&2
	@exit 2
{% endif %}
{% block fullTestTarget %}test: test-unit ## Run every test required by this project's capabilities.
{% endblock %}

check: lint typecheck{% if withTesting | default(true) %} test{% endif %} ## Run the mandatory non-mutating checks.
	$(UV) lock --check

{% block buildCommand %}build: ## Build the wheel and source distribution.
	$(UV) build --no-build-isolation
{% endblock %}{% block runCommand %}{% endblock %}{% block extraCommands %}{% endblock %}

# Project-owned commands survive Copier updates without copying shared recipes.
-include Makefile.local

endif
