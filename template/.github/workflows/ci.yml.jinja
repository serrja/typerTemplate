name: CI
on:
  push:
    branches: [main]
  pull_request:
permissions:
  contents: read
concurrency:
  group: ci-{% raw %}${{ github.workflow }}{% endraw %}-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true
jobs:
  source:
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: {% raw %}${{ github.event.pull_request.head.sha || github.sha }}{% endraw %}
      - uses: ./.github/actions/actionlint
      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1
      - name: Restore the locked Docker toolchain and dependency graph
        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0
        with:
          context: .
          file: Dockerfile.quality
          target: quality
          load: true
          tags: {{ packageName }}:quality
          cache-from: type=gha,scope={% raw %}${{ github.repository_id }}{% endraw %}-quality-linux-amd64-{% raw %}${{ github.event_name == 'pull_request' && 'review' || 'trusted' }}{% endraw %}
          cache-to: type=gha,mode=max,scope={% raw %}${{ github.repository_id }}{% endraw %}-quality-linux-amd64-{% raw %}${{ github.event_name == 'pull_request' && 'review' || 'trusted' }}{% endraw %}
      - name: Fresh native checks, distributions and installed-package verification
        run: make ci-local
      - name: Advisory coverage summary
        if: always()
        run: test ! -f coverage/summary.md || cat coverage/summary.md >> "$GITHUB_STEP_SUMMARY"
      - name: Source, report and package evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: verified-{% raw %}${{ github.event.pull_request.head.sha || github.sha }}{% endraw %}
          path: |
            coverage/
            dist/
          if-no-files-found: error
          retention-days: 14
  required:
    if: always()
    needs: [source]
    runs-on: ubuntu-24.04
    timeout-minutes: 2
    steps:
      - env: {RESULT: '{% raw %}${{ needs.source.result }}{% endraw %}'}
        run: test "$RESULT" = success
