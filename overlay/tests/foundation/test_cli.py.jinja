"""Exercise CLI parsing, lazy settings, source priority and safe errors."""

import os
import shutil
import subprocess
import sys
from importlib.metadata import version
from pathlib import Path

import pytest
from pydantic import ValidationError
from typer.testing import CliRunner

from {{ packageName }}.cli import app
from {{ packageName }}.settings import Settings, load_settings


@pytest.fixture(autouse=True)
def isolated_settings(monkeypatch: pytest.MonkeyPatch) -> None:
    for name in list(os.environ):
        if name.startswith("{{ packageName | upper }}_"):
            monkeypatch.delenv(name)


@pytest.mark.parametrize(
    "arguments",
    [[], ["--help"], ["config", "--help"], ["config", "show", "--help"], ["--version"]],
)
def test_help_and_version_ignore_invalid_configuration(arguments: list[str]) -> None:
    environment = {"{{ packageName | upper }}_LIMIT": "invalid"}
    result = CliRunner().invoke(app, arguments, env=environment)
    assert result.exit_code == 0, result.output
    assert not result.stderr
    if arguments == ["--version"]:
        assert result.stdout.strip() == version("{{ packageName }}")


@pytest.mark.parametrize(
    "arguments",
    [
        ["missing"],
        ["config", "missing"],
        ["config", "show", "extra"],
        ["config", "show", "--limit"],
        ["config", "show", "--limit", "invalid"],
    ],
)
def test_invalid_arguments_are_errors(arguments: list[str]) -> None:
    result = CliRunner().invoke(app, arguments)
    assert result.exit_code == 2
    assert result.stderr and not result.stdout


def test_cli_env_file_defaults_priority_and_read_only(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    config = tmp_path / "параметры проверки.env"
    contents = "{{ packageName | upper }}_ENABLED=false\n"
    contents += "{{ packageName | upper }}_LIMIT=3\n"
    config.write_text(contents)
    before = config.read_bytes()
    runner = CliRunner()
    assert "enabled=true limit=10" in runner.invoke(app, ["config", "show"]).stdout
    arguments = ["config", "show", "--config", str(config)]
    assert "enabled=false limit=3" in runner.invoke(app, arguments).stdout
    monkeypatch.setenv("{{ packageName | upper }}_LIMIT", "7")
    assert "limit=7" in runner.invoke(app, arguments).stdout
    result = runner.invoke(app, [*arguments, "--limit", "0", "--no-enabled"], input="")
    assert result.exit_code == 0 and "enabled=false limit=0" in result.stdout
    assert config.read_bytes() == before
    assert list(tmp_path.iterdir()) == [config]


def test_invalid_settings_and_unknown_fields_do_not_leak(tmp_path: Path) -> None:
    secret = "SYNTHETIC_SECRET_DO_NOT_LOG"
    config = tmp_path / "secret.env"
    config.write_text(f"{{ packageName | upper }}_LIMIT={secret}\n")
    result = CliRunner().invoke(app, ["config", "show", "--config", str(config)])
    assert result.exit_code == 2
    assert result.stderr == "Invalid or unavailable configuration.\n"
    assert secret not in result.output and not result.stdout
    assert config.read_text().endswith(secret + "\n")
    with pytest.raises(ValidationError) as failure:
        Settings(limit=secret)
    assert secret not in str(failure.value)
    config.write_text(f"UNEXPECTED={secret}\n")
    assert (
        CliRunner().invoke(app, ["config", "show", "--config", str(config)]).exit_code
        == 2
    )
    assert (
        CliRunner()
        .invoke(app, ["config", "show", "--config", str(tmp_path / "missing")])
        .exit_code
        == 2
    )


def test_settings_serialization_schema_and_explicit_null() -> None:
    settings = load_settings(None, False, 0)
    assert settings.model_dump() == {"enabled": False, "limit": 0}
    assert Settings.model_validate_json(settings.model_dump_json()) == settings
    assert Settings.model_json_schema()["properties"]["limit"]["minimum"] == 0
    with pytest.raises(ValidationError):
        Settings.model_validate({"limit": None})


def test_real_executable_and_module_outside_checkout(tmp_path: Path) -> None:
    executable = shutil.which("{{ projectName }}")
    assert executable is not None
    environment = dict(os.environ)
    environment.pop("PYTHONPATH", None)
    environment["{{ packageName | upper }}_LIMIT"] = "invalid"
    for command in [
        [executable, "--version"],
        [sys.executable, "-m", "{{ packageName }}", "--version"],
    ]:
        result = subprocess.run(
            command,
            cwd=tmp_path,
            env=environment,
            text=True,
            capture_output=True,
            check=False,
            timeout=10,
        )
        assert result.returncode == 0, result.stderr
        assert result.stdout.strip() == version("{{ packageName }}")
        assert not result.stderr
